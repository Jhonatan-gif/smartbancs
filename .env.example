# Copia este archivo a .env (opcional: todo tiene valores por defecto)
POSTGRES_USER=smartbancs
POSTGRES_PASSWORD=smartbancs
POSTGRES_DB=smartbancs

# on = seguro (bloqueo ordenado). off = reproduce el deadlock del incidente (solo demo).
LOCK_ORDERING=on
SIMULATED_LOCK_DELAY_MS=0

DB_POOL_MAX=20
LOG_LEVEL=info

# Puertos publicados en tu PC (cámbialos si ya están ocupados, p. ej. por un PostgreSQL local)
POSTGRES_PORT=5432
REDIS_PORT=6379

# Simulador del legado (Bancs) y protección del worker
BANCS_FAILURE_RATE=0.1
BANCS_MAX_RPS=10
BANCS_BATCH_SIZE=25
BANCS_MAX_CALLS_PER_SEC=5
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_MS=5000

# ai-service (recomendaciones): timeout corto para que la IA nunca retrase una respuesta
AI_TIMEOUT_MS=300

# Observabilidad (perfil obs): contraseña del admin de Grafana y muestreo de trazas (1.0 = todas)
GRAFANA_ADMIN_PASSWORD=admin
OTEL_TRACES_SAMPLER_ARG=1.0
SLOW_OP_MS=200
