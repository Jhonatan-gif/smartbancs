# Copia este archivo a .env (opcional: todo tiene valores por defecto)
POSTGRES_USER=smartbancs
POSTGRES_PASSWORD=smartbancs
POSTGRES_DB=smartbancs

# on = seguro (bloqueo ordenado). off = reproduce el deadlock del incidente (solo demo).
LOCK_ORDERING=on
SIMULATED_LOCK_DELAY_MS=0

DB_POOL_MAX=20
LOG_LEVEL=info
