      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(transfers_total{outcome=\"error\"}[2m])) / clamp_min(sum(rate(transfers_total[2m])), 1e-9)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "mappings": [],
