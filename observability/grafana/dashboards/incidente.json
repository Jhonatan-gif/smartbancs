    {
      "id": 19,
      "type": "table",
      "title": "Trazas de transferencias más lentas (> 100 ms)",
      "description": "Abre una traza para ver cada paso SQL (db.lock_accounts, db.debit...), el outbox y la sincronización con Bancs (bancs.sync)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"core-api\" && name = \"POST /v1/transfers\" && duration > 100ms }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 20,
      "type": "table",
      "title": "Trazas con error (deadlocks, timeouts)",
